---
import BaseLayout from "../../components/BaseLayout.astro";
import { getAllTags } from "../../utils/tags";

const tags = await getAllTags();
---

<BaseLayout title="tags" description="Browse posts by tag.">
  <header class="page-head">
    <p class="eyebrow">Topics</p>
    <h1>Browse by tag</h1>
    <p>Every topic written about so far.</p>
  </header>

  {
    tags.length === 0 ? (
      <p class="empty-state">No tags yet — check back soon.</p>
    ) : (
      <ul class="tag-cloud">
        {tags.map(({ tag, slug, count }) => (
          <li>
            <a href={`/tags/${slug}/`}>
              <span class="name">#{tag.toLowerCase()}</span>
              <span class="count">{count}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .page-head {
    margin-bottom: 2.5rem;
  }
  .page-head h1 {
    margin: 0.5rem 0 0.4rem;
  }
  .page-head p {
    margin: 0;
    color: var(--text-soft);
    font-size: var(--step-1);
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tag-cloud li {
    margin: 0;
  }
  .tag-cloud a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    font-size: var(--step-0);
    color: var(--text);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    text-decoration: none;
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }
  .tag-cloud a:hover {
    border-color: var(--text);
  }
  .tag-cloud .name {
    font-weight: 500;
  }
  .tag-cloud .count {
    font-size: var(--step--1);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .empty-state {
    margin: 0;
    padding: 4rem 0;
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: var(--step-1);
    text-align: center;
  }
</style>
