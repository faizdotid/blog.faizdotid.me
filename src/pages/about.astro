---
import { Image } from "astro:assets";
import AboutHeroImage from "../assets/blog-placeholder-about.jpg";
import BaseLayout from "../components/BaseLayout.astro";
import { EMAIL } from "../consts";
---

<BaseLayout
  title="about"
  description="A little about me and what I write here."
  image={AboutHeroImage}
  width="full"
>
  <article>
    <header class="about-header">
      <div class="prose">
        <p class="eyebrow">About</p>
        <h1>A bit about me</h1>
      </div>
    </header>

    <div class="hero-image">
      <Image width={1020} height={510} src={AboutHeroImage} alt="" />
    </div>

    <div class="prose">
      <p>
        Hi, I'm Faizal and I'm interested in tech, especially programming and
        how things work behind the scenes. I write about things I'm learning,
        ideas I'm exploring, and tools I use.
      </p>

      <p>
        I'm sharing my learning journey here. Hopefully, you find something
        useful or at least interesting.
      </p>

      <p>I’ll add more about myself soon.</p>

      <p>
        If something here helps, or you just want to say hi, reach me at{" "}
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a> or find me on{" "}
        <a href="https://github.com/faizdotid" target="_blank" rel="noopener"
          >GitHub</a
        >.
      </p>

      <p>Thanks for stopping by.</p>
    </div>
  </article>
</BaseLayout>

<style>
  .prose {
    width: var(--content-width);
    max-width: calc(100% - 2.5rem);
    margin-inline: auto;
  }

  .about-header {
    padding: 3rem 0 2.5rem;
    text-align: center;
  }
  .about-header .eyebrow {
    margin-bottom: 0.6rem;
  }
  .about-header h1 {
    margin: 0;
  }

  .hero-image {
    margin: 0 0 3rem;
  }
  .hero-image img {
    display: block;
    width: var(--wide-width);
    max-width: calc(100% - 2.5rem);
    margin-inline: auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }

  .prose p {
    margin: 0 0 1.5rem;
  }
  .prose a {
    text-decoration: underline;
  }
</style>
