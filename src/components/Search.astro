---
// Client-side search. Reads /search.json (built by src/pages/search.json.ts)
// and filters it in a command-palette style modal. Open with the button,
// ⌘K / Ctrl+K, or "/".
---

<button
  id="search-open"
  class="icon-btn"
  type="button"
  aria-label="Search posts"
  aria-keyshortcuts="Control+K Meta+K"
>
  <svg
    viewBox="0 0 24 24"
    width="19"
    height="19"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m21 21-4.3-4.3"></path>
  </svg>
</button>

<dialog id="search-dialog" class="search-dialog" aria-label="Search posts">
  <div class="search-panel">
    <div class="search-input-row">
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="Search posts…"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        aria-label="Search posts"
      />
      <kbd>esc</kbd>
    </div>
    <ul id="search-results" class="search-results"></ul>
    <p id="search-empty" class="search-empty" hidden>No posts found.</p>
    <p id="search-hint" class="search-empty">Type to search posts.</p>
  </div>
</dialog>

<script>
  const dialog = document.getElementById(
    "search-dialog",
  ) as HTMLDialogElement | null;
  const openBtn = document.getElementById("search-open");
  const input = document.getElementById(
    "search-input",
  ) as HTMLInputElement | null;
  const resultsEl = document.getElementById("search-results");
  const emptyEl = document.getElementById("search-empty");
  const hintEl = document.getElementById("search-hint");

  type Entry = {
    title: string;
    description: string;
    slug: string;
    body: string;
  };

  let index: Entry[] | null = null;
  let current: Entry[] = [];
  let activeIndex = -1;

  async function loadIndex() {
    if (!index) {
      const res = await fetch("/search.json");
      index = (await res.json()) as Entry[];
    }
    return index;
  }

  function open() {
    if (!dialog || dialog.open) return;
    dialog.showModal();
    loadIndex();
    input!.value = "";
    render([], "");
    input!.focus();
  }

  function escapeHtml(s: string) {
    return s.replace(
      /[&<>"]/g,
      (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[
          c
        ] as string,
    );
  }

  function highlight(text: string, query: string) {
    const safe = escapeHtml(text);
    if (!query) return safe;
    const pattern = query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    return safe.replace(new RegExp(`(${pattern})`, "ig"), "<mark>$1</mark>");
  }

  function score(entry: Entry, q: string) {
    let s = 0;
    if (entry.title.toLowerCase().includes(q)) s += 10;
    if (entry.description.toLowerCase().includes(q)) s += 4;
    if (entry.body.toLowerCase().includes(q)) s += 1;
    return s;
  }

  function render(items: Entry[], query: string) {
    current = items;
    activeIndex = items.length ? 0 : -1;
    resultsEl!.innerHTML = items
      .map(
        (entry, i) => `
				<li>
					<a href="/blog/${entry.slug}/" data-i="${i}" class="${i === 0 ? "active" : ""}">
						<span class="r-title">${highlight(entry.title, query)}</span>
						<span class="r-desc">${highlight(entry.description, query)}</span>
					</a>
				</li>`,
      )
      .join("");

    const hasQuery = query.length > 0;
    hintEl!.hidden = hasQuery;
    emptyEl!.hidden = !(hasQuery && items.length === 0);
  }

  function setActive(next: number) {
    if (!current.length) return;
    activeIndex = (next + current.length) % current.length;
    resultsEl!
      .querySelectorAll("a")
      .forEach((a, i) => a.classList.toggle("active", i === activeIndex));
    resultsEl!.querySelector("a.active")?.scrollIntoView({ block: "nearest" });
  }

  openBtn?.addEventListener("click", open);

  input?.addEventListener("input", async () => {
    const data = await loadIndex();
    const query = input.value.trim();
    if (!query) return render([], "");
    const q = query.toLowerCase();
    const matches = data
      .map((entry) => ({ entry, s: score(entry, q) }))
      .filter((m) => m.s > 0)
      .sort((a, b) => b.s - a.s)
      .slice(0, 8)
      .map((m) => m.entry);
    render(matches, query);
  });

  dialog?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") {
      e.preventDefault();
      setActive(activeIndex + 1);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setActive(activeIndex - 1);
    } else if (e.key === "Enter") {
      const link = resultsEl!.querySelector<HTMLAnchorElement>(
        `a[data-i="${activeIndex}"]`,
      );
      if (link) {
        e.preventDefault();
        window.location.href = link.href;
      }
    }
  });

  // Click outside the panel closes the modal.
  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });

  // Global shortcuts: ⌘K / Ctrl+K anywhere, "/" when not typing.
  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      open();
    } else if (
      e.key === "/" &&
      !/^(input|textarea|select)$/i.test(
        (document.activeElement as HTMLElement)?.tagName,
      ) &&
      !dialog?.open
    ) {
      e.preventDefault();
      open();
    }
  });
</script>

<style>
  .search-dialog {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    background: transparent;
    border: none;
    overflow: hidden;
  }
  .search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .search-panel {
    width: min(560px, calc(100% - 2rem));
    margin: 12vh auto 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    animation: pop 0.18s cubic-bezier(0.23, 1, 0.32, 1);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .search-input-row {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    transition: color 0.18s ease;
  }
  .search-input-row:focus-within {
    color: var(--text);
  }
  .search-input-row input {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--text);
    font-family: var(--font-body);
    font-size: 1.05rem;
    outline: none;
  }
  .search-input-row input::placeholder {
    color: var(--text-muted);
  }
  .search-input-row input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }
  kbd {
    font-family: var(--font-code);
    font-size: 0.7rem;
    padding: 0.2em 0.45em;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    background: var(--surface-2);
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    max-height: min(56vh, 420px);
    overflow-y: auto;
  }
  /* Results are injected at runtime via innerHTML, so these elements don't
	   carry Astro's scope attribute — the selectors must be :global(). */
  .search-results :global(li) {
    margin: 0;
  }
  .search-results :global(a) {
    display: block;
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--text);
    text-decoration: none;
    line-height: 1.4;
  }
  .search-results :global(a.active),
  .search-results :global(a:hover) {
    background: var(--surface-2);
  }
  .search-results :global(.r-title) {
    display: block;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .search-results :global(.r-desc) {
    display: block;
    margin-top: 0.15rem;
    font-size: var(--step--1);
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .search-results :global(mark) {
    background: color-mix(in oklab, var(--accent) 22%, transparent);
    color: var(--text);
    font-weight: 600;
    border-radius: 3px;
    padding: 0 0.1em;
  }

  .search-empty {
    margin: 0;
    padding: 1.4rem 1rem;
    text-align: center;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
</style>
