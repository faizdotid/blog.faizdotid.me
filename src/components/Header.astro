---
import { NAV_LINKS, SITE_TITLE, SOCIAL_LINKS } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import Search from "./Search.astro";
import SocialIcon from "./SocialIcon.astro";

// Surface the primary social link (GitHub if present) next to the theme toggle.
const primarySocial =
  SOCIAL_LINKS.find((s) => s.icon === "github") ?? SOCIAL_LINKS[0];
---

<header>
  <nav>
    <a class="brand" href="/">{SITE_TITLE}</a>

    <div class="internal-links">
      {
        NAV_LINKS.map((link) => (
          <HeaderLink href={link.href}>{link.label}</HeaderLink>
        ))
      }
    </div>

    <div class="actions">
      <Search />
      <button
        id="theme-toggle"
        class="icon-btn"
        type="button"
        aria-label="Toggle color theme"
      >
        <svg
          class="sun"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
          ></path>
        </svg>
        <svg
          class="moon"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <a
        class="icon-btn header-social"
        href={primarySocial.href}
        target="_blank"
        rel="noopener"
      >
        <span class="sr-only">{primarySocial.label}</span>
        <SocialIcon name={primarySocial.icon} />
      </a>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    btn.addEventListener("click", () => {
      const next =
        document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      localStorage.setItem("theme", next);
    });
  })();
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--border);
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: var(--wide-width);
    max-width: calc(100% - 2.5rem);
    margin-inline: auto;
    height: 64px;
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: none;
  }
  .brand:hover {
    color: var(--text-soft);
  }

  .internal-links {
    display: flex;
    gap: 0.25rem;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  #theme-toggle .moon {
    display: none;
  }
  :global(html[data-theme="dark"]) #theme-toggle .sun {
    display: none;
  }
  :global(html[data-theme="dark"]) #theme-toggle .moon {
    display: block;
  }

  @media (max-width: 600px) {
    nav {
      gap: 0.5rem;
    }
    .internal-links {
      gap: 0;
    }
    /* Tighten the nav pills so they fit alongside the action icons. */
    .internal-links :global(a) {
      padding: 0.4rem 0.55rem;
      font-size: 0.9rem;
    }
    /* GitHub is also in the footer — drop it here to save space. */
    .header-social {
      display: none;
    }
  }
</style>
