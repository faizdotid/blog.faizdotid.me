---
import { slugifyTag } from "../utils/tags";

interface Props {
  tags: string[];
  /** Render plain (non-clickable) pills — needed inside card links to avoid nested <a>. */
  linked?: boolean;
  size?: "sm" | "md";
}

const { tags = [], linked = true, size = "md" } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class:list={["tags", size]}>
      {tags.map((tag) =>
        linked ? (
          <li>
            <a href={`/tags/${slugifyTag(tag)}/`}>#{tag.toLowerCase()}</a>
          </li>
        ) : (
          <li>
            <span>#{tag.toLowerCase()}</span>
          </li>
        ),
      )}
    </ul>
  )
}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tags li {
    margin: 0;
  }
  .tags a,
  .tags span {
    display: inline-block;
    padding: 0.25em 0.7em;
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-soft);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    text-decoration: none;
    transition:
      color 0.18s ease,
      border-color 0.18s ease,
      background-color 0.18s ease;
  }
  .tags.sm a,
  .tags.sm span {
    padding: 0.15em 0.55em;
    font-size: 0.72rem;
  }
  .tags a:hover {
    color: var(--text);
    border-color: var(--text);
  }
</style>
