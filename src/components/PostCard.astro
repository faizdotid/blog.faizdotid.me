---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import TagList from "./TagList.astro";

interface Props {
  post: CollectionEntry<"blog">;
  /** Larger layout used for the lead post on the blog index. */
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate, heroImage, tags } = post.data;
const [imgWidth, imgHeight] = featured ? [720, 450] : [600, 375];
---

<a class:list={["card", { featured }]} href={`/blog/${post.id}/`}>
  {
    heroImage && (
      <div class="card-img">
        <Image width={imgWidth} height={imgHeight} src={heroImage} alt="" />
      </div>
    )
  }
  <div class="card-body">
    <span class="meta">
      {featured && "Featured · "}<FormattedDate date={pubDate} />
    </span>
    <h2 class="title">{title}</h2>
    <p class="excerpt">{description}</p>
    <TagList tags={tags} linked={false} size="sm" />
  </div>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .card-img {
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .card-img img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 0;
    transition: transform 0.4s ease;
  }
  .card:hover .card-img img {
    transform: scale(1.04);
  }
  .title {
    margin: 0.7rem 0 0.3rem;
    font-size: var(--step-2);
    line-height: 1.2;
    transition: color 0.18s ease;
  }
  .card:hover .title {
    color: var(--accent);
  }
  .meta {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text-muted);
  }
  .excerpt {
    margin: 0.4rem 0 0;
    color: var(--text-soft);
    font-size: var(--step-0);
  }
  .card-body :global(.tags) {
    margin-top: 0.7rem;
  }

  /* Featured: image and text side by side. */
  .card.featured {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
    align-items: center;
  }
  .card.featured .title {
    font-size: var(--step-4);
  }
  .card.featured .excerpt {
    font-size: var(--step-1);
  }

  @media (max-width: 720px) {
    .card.featured {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }
    .card.featured .title {
      font-size: var(--step-3);
    }
  }
</style>
