---
import { EMAIL, SITE_TITLE, SOCIAL_LINKS } from "../consts";
import SocialIcon from "./SocialIcon.astro";

const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <a class="footer-brand" href={`mailto:${EMAIL}`}>{EMAIL}</a>

    <p class="copyright">&copy; {`${year} ${SITE_TITLE}`}</p>

    <div class="social-links">
      {
        SOCIAL_LINKS.map((social) => (
          <a href={social.href} target="_blank" rel="noopener">
            <span class="sr-only">{social.label}</span>
            <SocialIcon name={social.icon} />
          </a>
        ))
      }
    </div>
  </div>
</footer>

<style>
  footer {
    flex-shrink: 0;
    margin-top: 4rem;
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    width: var(--wide-width);
    max-width: calc(100% - 2.5rem);
    margin-inline: auto;
    padding: 2rem 0;
  }
  .footer-brand {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
  }
  .footer-brand:hover {
    color: var(--text-soft);
  }
  .copyright {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .copyright a {
    font-weight: 600;
  }
  .social-links {
    display: flex;
    gap: 0.4rem;
  }
  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    color: var(--text-muted);
    transition:
      color 0.18s ease,
      background-color 0.18s ease;
  }
  .social-links a:hover {
    color: var(--accent);
    background: var(--surface);
  }
  @media (max-width: 600px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
